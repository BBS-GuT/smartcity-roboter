{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BBS-GuT/smartcity-roboter/schemas/grundbetrieb-v2.schema.json",
  "title": "SmartCity Grundbetrieb Zustandsdatensatz",
  "description": "Version 2.0, unveroeffentlichtes Fundament; keine vollstaendige Gesamtannahme. Raster, Endlichkeit, Uhrenbezug und Altersgleichheit prueft Python. Nur die STRUKTUR. Die fachlichen Regeln R1-R11 (z. B. keine Bewegung bei STOPP-Sperre, valid <=> Wert vorhanden) prueft lib/grundbetrieb_vertrag.py; siehe docs/schnittstellen-grundbetrieb.md. Zahlen in SI-Einheiten laut Feldname (_m, _s, _m_s, _rad, _rad_s, _hz, _v).",
  "$defs": {
    "status": {
      "enum": [
        "valid",
        "unknown",
        "invalid",
        "stale",
        "missing"
      ]
    },
    "messwert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "quelle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "status",
        "reason",
        "captured_at_s",
        "received_mono_s",
        "age_s",
        "rate_hz",
        "frame_id",
        "coord_frame",
        "producer_id",
        "producer_boot_id",
        "time_basis_id",
        "captured_mono_s"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "captured_at_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "received_mono_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036.854775807
        },
        "age_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036.854775807
        },
        "rate_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "frame_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "coord_frame": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "producer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "producer_boot_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "time_basis_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "captured_mono_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036.854775807
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "robot_id",
    "boot_id",
    "seq",
    "generated_at",
    "generated_mono_s",
    "time_sync",
    "software_version",
    "map_version",
    "config_version",
    "runtime",
    "motion",
    "lane",
    "route",
    "traffic",
    "obstacles",
    "sensors",
    "diagnostics",
    "communication",
    "details",
    "time_basis_id"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "robot_id": {
      "enum": [
        "RM01",
        "RM02",
        "RM03",
        "RM04"
      ]
    },
    "boot_id": {
      "type": "string",
      "minLength": 8
    },
    "seq": {
      "type": [
        "integer"
      ],
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d{1,9})?Z$"
    },
    "generated_mono_s": {
      "type": [
        "number"
      ],
      "minimum": 0,
      "maximum": 9223372036.854775807
    },
    "time_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "synced",
            "unsynced",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "software_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "map_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "config_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "state",
        "motor_enabled",
        "stop_latched",
        "fault_latched",
        "hold_reasons",
        "faults"
      ],
      "properties": {
        "mode": {
          "const": "GRUNDBETRIEB"
        },
        "state": {
          "enum": [
            "GESTOPPT",
            "TEST",
            "BEREIT",
            "SPURFOLGEN",
            "KREUZUNG_ANNAEHERN",
            "VERKEHRSHALT",
            "MANOEVER",
            "AUSFAHRT_BESTAETIGEN",
            "FEHLER"
          ]
        },
        "motor_enabled": {
          "type": "boolean"
        },
        "stop_latched": {
          "type": "boolean"
        },
        "fault_latched": {
          "type": "boolean"
        },
        "hold_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "STOP_LATCHED",
              "FAULT",
              "TEST_MODE",
              "NO_REQUEST",
              "RED_LIGHT",
              "YELLOW_LIGHT",
              "SIGNAL_UNKNOWN",
              "STOP_SIGN",
              "CROSSING_OCCUPIED",
              "FRONT_BLOCKED",
              "DISTANCE_LOCK",
              "SENSOR_MISSING",
              "SENSOR_STALE",
              "SENSOR_INVALID",
              "LINE_LOST",
              "LOCALIZATION_UNKNOWN",
              "MANEUVER_FAILED"
            ]
          }
        },
        "faults": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "output",
        "measured_v_m_s",
        "measured_w_rad_s",
        "odometry_distance_m",
        "heading_rad"
      ],
      "properties": {
        "request": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request_id",
                "valid_until_mono_s",
                "v_m_s",
                "w_rad_s",
                "maneuver",
                "hold_reasons"
              ],
              "properties": {
                "request_id": {
                  "type": "string",
                  "minLength": 1
                },
                "valid_until_mono_s": {
                  "type": [
                    "number"
                  ],
                  "minimum": 0,
                  "maximum": 9223372036.854775807
                },
                "v_m_s": {
                  "type": [
                    "number"
                  ],
                  "minimum": -1,
                  "maximum": 1
                },
                "w_rad_s": {
                  "type": [
                    "number"
                  ],
                  "minimum": -10,
                  "maximum": 10
                },
                "maneuver": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "hold_reasons": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "STOP_LATCHED",
                      "FAULT",
                      "TEST_MODE",
                      "NO_REQUEST",
                      "RED_LIGHT",
                      "YELLOW_LIGHT",
                      "SIGNAL_UNKNOWN",
                      "STOP_SIGN",
                      "CROSSING_OCCUPIED",
                      "FRONT_BLOCKED",
                      "DISTANCE_LOCK",
                      "SENSOR_MISSING",
                      "SENSOR_STALE",
                      "SENSOR_INVALID",
                      "LINE_LOST",
                      "LOCALIZATION_UNKNOWN",
                      "MANEUVER_FAILED"
                    ]
                  }
                }
              }
            }
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v_m_s",
            "w_rad_s"
          ],
          "properties": {
            "v_m_s": {
              "type": [
                "number"
              ],
              "minimum": -1,
              "maximum": 1
            },
            "w_rad_s": {
              "type": [
                "number"
              ],
              "minimum": -10,
              "maximum": 10
            }
          }
        },
        "measured_v_m_s": {
          "$ref": "#/$defs/messwert"
        },
        "measured_w_rad_s": {
          "$ref": "#/$defs/messwert"
        },
        "odometry_distance_m": {
          "$ref": "#/$defs/messwert"
        },
        "heading_rad": {
          "$ref": "#/$defs/messwert"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "offset_m",
        "heading_error_rad"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "offset_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "heading_error_rad": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -3.141592653589793,
          "maximum": 3.141592653589793
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "node",
        "approach_from",
        "direction",
        "allowed_exits",
        "selected_exit",
        "maneuver",
        "maneuver_progress",
        "localization_status",
        "localization_quality"
      ],
      "properties": {
        "section": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "node": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "approach_from": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "direction": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "allowed_exits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_exit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "maneuver": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "maneuver_progress": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "localization_status": {
          "$ref": "#/$defs/status"
        },
        "localization_quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "signal",
        "signal_status",
        "signal_confidence",
        "signs",
        "crossings"
      ],
      "properties": {
        "signal_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "signal": {
          "enum": [
            "red",
            "yellow",
            "green",
            "off",
            "unknown"
          ]
        },
        "signal_status": {
          "$ref": "#/$defs/status"
        },
        "signal_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "signs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "status",
              "confidence"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "crossings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "occupancy",
              "status"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "occupancy": {
                "enum": [
                  "free",
                  "occupied",
                  "unknown"
                ]
              },
              "status": {
                "$ref": "#/$defs/status"
              }
            }
          }
        }
      }
    },
    "obstacles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corridor",
        "front_clearance_m",
        "unknown_areas",
        "distance_locks",
        "objects"
      ],
      "properties": {
        "corridor": {
          "enum": [
            "free",
            "occupied",
            "unknown"
          ]
        },
        "front_clearance_m": {
          "$ref": "#/$defs/messwert"
        },
        "unknown_areas": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "distance_locks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "distance_m",
              "lateral_m",
              "in_corridor",
              "source",
              "frame_id"
            ],
            "properties": {
              "class": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "distance_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "lateral_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "in_corridor": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "frame_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sensors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/quelle"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battery_v",
        "board_status",
        "warnings",
        "events"
      ],
      "properties": {
        "battery_v": {
          "$ref": "#/$defs/messwert"
        },
        "board_status": {
          "$ref": "#/$defs/status"
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "mono_s",
              "kind",
              "text"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "mono_s": {
                "type": [
                  "number"
                ],
                "minimum": 0,
                "maximum": 9223372036.854775807
              },
              "kind": {
                "enum": [
                  "info",
                  "stop",
                  "drive",
                  "warning",
                  "fault"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker",
        "last_publish_requested_seq",
        "last_broker_ack_seq",
        "last_broker_ack_mono_s",
        "reconnects",
        "dropped_messages",
        "last_error"
      ],
      "properties": {
        "broker": {
          "enum": [
            "connected",
            "disconnected",
            "unknown",
            "disabled"
          ]
        },
        "last_publish_requested_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "last_broker_ack_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "last_broker_ack_mono_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036.854775807
        },
        "reconnects": {
          "type": [
            "integer"
          ],
          "minimum": 0
        },
        "dropped_messages": {
          "type": [
            "integer"
          ],
          "minimum": 0
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "data_id",
          "format",
          "captured_at_s",
          "frame_id",
          "status"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "data_id": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "captured_at_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "frame_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    "time_basis_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
