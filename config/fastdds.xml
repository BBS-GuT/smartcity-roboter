<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS (Uebertragung von ROS 2): groesserer Shared-Memory-Bereich.
     Standard sind 512 KB; ein Kamerabild hat ~900 KB und wuerde sonst ueber das
     (langsamere, verlustreichere) Netzwerk-Verfahren geschickt.
     Wird von scripts/env.sh fuer UNSERE Programme gesetzt (nicht fuer Yahboom-Programme). -->
<profiles xmlns="http://www.eprosima.com/xml/schemas/fastrtps_profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_gross</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="smartcity" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_gross</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
